# Copy this file to .env before running the benchmark.
# Never commit the real key. The complete matrix requires an OpenRouter key;
# local-only runs can leave this value empty and select Ollama models explicitly.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434

# Optional Gurobi Web License Service settings.
WLSACCESSID=
WLSSECRET=
LICENSEID=
